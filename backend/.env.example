# copy to .env for local development (npm run start:images / start:logs). docker compose also
# reads it for the tunables, but sets hosts, ports and DATA_DIR itself.

# shared: MongoDB and Redis
MONGO_URL=mongodb://localhost:27017
REDIS_HOST=localhost
REDIS_PORT=6379

# images service (A)
IMAGES_PORT=3000
IMAGES_MONGO_DB=images
DATA_DIR=./data
NASA_API_URL=https://images-api.nasa.gov
NASA_FETCH_QUERIES=apollo,mars,moon,earth,nebula,galaxy,hubble,shuttle,iss,saturn,jupiter,astronaut
NASA_FETCH_TARGET=20000
NASA_PAGE_SIZE=100
NASA_FETCH_CONCURRENCY=4
IMPORT_BATCH_SIZE=500
UPLOAD_MAX_MB=100

# logs service (B)
LOGS_PORT=3001
LOGS_MONGO_DB=logs
REPORT_GRPC_URL=localhost:50051
