{
  "name": "lumana-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build images && nest build logs",
    "start:images": "nest start images --watch",
    "start:logs": "nest start logs --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stream-json": "^3.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@rspack/core": "^2.2.8",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~6.0.3",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
